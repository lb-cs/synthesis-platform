# Copy to .env.local and fill in real values. .env.local is gitignored.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only: this key bypasses row-level security. Never prefix it with NEXT_PUBLIC_
# and never commit a real value. Used by Settings > Delete account.
# Local: the secret (service role) key printed by `supabase status`.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only: Vercel AI Gateway key for every model call — chat and question embeddings
# (lib/ai.ts). Never prefix it with NEXT_PUBLIC_. Create one in the Vercel dashboard under
# AI Gateway. Not needed on Vercel deployments: OIDC signs requests.
AI_GATEWAY_API_KEY=
