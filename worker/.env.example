# Copy to worker/.env and fill in from `supabase status`. worker/.env is gitignored.

# The API URL, e.g. http://127.0.0.1:54321 locally.
SUPABASE_URL=http://127.0.0.1:54321

# The secret (service role) key. It bypasses row-level security: never commit a real
# value, and never put it anywhere the browser can read it.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API key used by the worker to embed source chunks. Keep this secret.
OPENAI_API_KEY=

# Optional. Sources processed at the same time by this worker process.
WORKER_CONCURRENCY=4

# Optional. Seconds between checks for new pending sources when the queue is empty.
WORKER_POLL_INTERVAL_SECONDS=5

# Optional. A source stuck in `processing` this long (a worker died) is marked failed.
WORKER_STALE_AFTER_MINUTES=15
